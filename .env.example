# 复制为 .env 后填写真实值；.env 已在 .gitignore 中排除。
# 本文件只放「键 + 说明 + 安全占位值」，不要提交任何真实密钥。

# ---------- 大模型（OpenAI 兼容接口）----------
# echo = 不调用模型（本地自测）；openai = 任意兼容端点；ollama = 本地模型
KB_LLM_PROVIDER=echo
KB_OPENAI_BASE=https://api.openai.com/v1
KB_OPENAI_API_KEY=sk-REPLACE_ME
KB_OPENAI_MODEL=gpt-4o-mini
# 部分模型支持思考档位（disabled / low / medium / high），留空则不传
KB_OPENAI_THINKING=

# ---------- 检索 ----------
KB_TOP_K=5
# 源码检索默认关闭；开启前先配好 KB_CODE_ROOT
KB_CODE_ENABLED=false
KB_CODE_ROOT=
KB_CODE_DIRS=

# ---------- Agent（工具调用）----------
KB_AGENT_ENABLED=true
KB_AGENT_MAX_STEPS=6
KB_AGENT_TIME_BUDGET=180
# 工具调试轨迹（生产建议关闭）
KB_AGENT_TRACE=false

# ---------- 鉴权 ----------
# Worker 转发时携带的共享密钥；留空表示不校验（仅限本机调试）
KB_GATEWAY_API_KEY=
# 设备令牌签名密钥；生产环境必须替换为随机值
KB_AUTH_SECRET=
KB_AUTH_TTL_DAYS=30
# 管理员 uid，逗号分隔（用于后台面板）
KB_ADMIN_UIDS=

# ---------- 服务 ----------
KB_HOST=127.0.0.1
KB_PORT=9000
KB_SESSION_TTL_DAYS=7
